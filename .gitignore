# ─── OS / Editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ─── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.ipynb_checkpoints/

# ─── Virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Build artifacts ──────────────────────────────────────────────────
build/
dist/
wheels/
*.manifest
*.spec

# ─── Logs / temp ──────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak
*.orig

# ─── Research artifacts (large / regenerable) ─────────────────────────
# Raw datasets and pretrained / init model weights.
data/
# Ablation outputs, rendered frames, PLYs, per-frame metrics.
results/
# Any experiment outputs generated by baselines.
output/
outputs/

# Common model / checkpoint formats.
*.ckpt
*.pth
*.pt
*.ply
*.splat

# TensorBoard / W&B traces.
runs/
wandb/
events.out.tfevents.*

# ─── Repo-specific drafts (per owner preference) ──────────────────────
# Internal design / paper drafts — NOT intended for public commits.
GLASS.md
Generated_image*.png

# Local submodule build / egg-info under baselines/ — belongs to
# upstream build system, not to this repo.
baselines/**/build/
baselines/**/*.egg-info/

# Exported patches are ignored by default, except reproducible baseline patches.
patches/
*.patch
!patches/
!patches/baselines/
!patches/baselines/*.patch

# Local scratch notes with raw measurement tables (kept out of VCS).
GLASS_Data.md
