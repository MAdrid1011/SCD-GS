diff --git a/scene/gaussian_model.py b/scene/gaussian_model.py
index 4dc2668..dd48fd7 100644
--- a/scene/gaussian_model.py
+++ b/scene/gaussian_model.py
@@ -1393,6 +1393,27 @@ class GaussianModel:
             print(f"GaussianModel::load_ply(): initialized Gaussian attributes from: {path}")
 
 
+    def init_prev_atts_from_current(self):
+        """Populate prev_atts and prev_latents from the currently loaded attributes.
+
+        Called after load_ply when starting incremental training from a
+        pre-trained frame-1 init model (start_frame_idx=2), so that gate
+        modulation and temporal-residual encoding have a valid Frame-1
+        reference on the very first incremental frame.
+
+        Without this call, prev_atts / prev_latents are all-None after
+        load_ply, causing both gate bypass and densification_postfix crashes.
+        """
+        with torch.no_grad():
+            for att_name in self.get_atts:
+                decoded = self.latent_decoders[att_name](self._latents[att_name])
+                self.prev_atts[att_name] = decoded.clone().requires_grad_(False)
+                self.prev_atts_initial[att_name] = decoded.clone().requires_grad_(False)
+                # prev_latents mirrors _latents (raw quantised codes) and is used
+                # by densification_postfix to clone/split latent tensors.  Normally
+                # set at the end of each frame; here we seed it from the init model.
+                self.prev_latents[att_name] = self._latents[att_name].clone().requires_grad_(False)
+
     def replace_tensor_to_optimizer(self, tensor, name, lr=None):
         optimizable_tensors = {}
         assert "ldec" not in name, "Latent decoder params cannot be replaced!"
diff --git a/train.py b/train.py
